{
    "name": "sicbo-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest --testPathPattern=src/",
        "test-coverage": "jest --collect-coverage --testPathPattern=src",
        "integration-test": "jest integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/sicbo-service.git"
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "chance": "^1.1.7",
        "nodemon": "^2.0.4",
        "random": "^2.2.0",
        "random-js": "^2.1.0",
        "sc-instrument": "1.1.1",
        "sc-game-base": "4.1.4-beta.2"
    },
    "resolutions": {
        "sc-base-apis": "1.18.2",
        "sc-base-database": "1.11.1",
        "socket.io-parser": "4.0.5",
        "mongoose": "6.13.6",
        "minimist": "1.2.6",
        "sc-game-base": "4.1.4-beta.2",
        "form-data": "4.0.4",
        "sc-common": "2.0.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.14.5",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@types/jest": "^26.0.23",
        "babel-jest": "^27.0.2",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^27.0.4",
        "jest-extended": "^0.11.5",
        "jest-junit": "^12.2.0",
        "jest-micro-auto-stub": "^1.0.5",
        "jest-sonar-reporter": "^2.0.0",
        "sc-game-service-integration-utils": "1.3.7"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "jest": {
        "testResultsProcessor": "jest-junit"
    }
}
